  "title": "Docker",
  "category": "Tools",
  "color": "#1d63ed",
  "language": "bash",
  "description": "Docker commands for images, containers, volumes, networks and Compose, plus a Dockerfile template.",
  "docs": "https://docs.docker.com/reference/",
  "sections": [
    {
      "title": "Images",
      "description": "Build and manage images.",
      "rows": [
        [
          "Build an image",
          [
            "docker build -t myapp .",
            "docker build -t myapp:1.0 -f Dockerfile.prod ."
          ]
        ],
        [
          "List images",
          "docker images"
        ],
        [
          "Pull / push",
          [
            "docker pull node:22-alpine",
            "docker push user/myapp:1.0"
          ]
        ],
        [
          "Tag an image",
          "docker tag myapp user/myapp:1.0"
        ],
        [
          "Remove an image",
          "docker rmi myapp"
        ],
        [
          "Remove unused images",
          "docker image prune -a"
        ]
      ]
    },
    {
      "title": "Containers",
      "description": "Run and manage containers.",
      "rows": [
        [
          "Run a container",
          "docker run --name web -p 8080:80 -d nginx"
        ],
        [
          "Run interactively and remove on exit",
          "docker run --rm -it ubuntu bash"
        ],
        [
          "Pass environment variables",
          [
            "docker run -e NODE_ENV=production myapp",
            "docker run --env-file .env myapp"
          ]
        ],
        [
          "Mount a folder",
          "docker run -v \"$(pwd)\":/app myapp"
        ],
        [
          "List containers",
          [
            "docker ps",
            "docker ps -a"
          ]
        ],
        [
          "Stop / start / restart",
          [
            "docker stop web",
            "docker start web",
            "docker restart web"
          ]
        ],
        [
          "Shell into a container",
          "docker exec -it web sh"
        ],
        [
          "View logs",
          [
            "docker logs web",
            "docker logs -f --tail 100 web"
          ]
        ],
        [
          "Remove a container",
          [
            "docker rm web",
            "docker rm -f web"
          ]
        ],
        [
          "Copy files",
          "docker cp web:/etc/nginx/nginx.conf ."
        ],
        [
          "Resource usage",
          "docker stats"
        ]
      ]
    },
    {
      "title": "Volumes & networks",
      "description": "Persistent data and connectivity.",
      "rows": [
        [
          "Create / list volumes",
          [
            "docker volume create data",
            "docker volume ls"
          ]
        ],
        [
          "Use a named volume",
          "docker run -v data:/var/lib/postgresql/data postgres"
        ],
        [
          "Create a network",
          "docker network create app-net"
        ],
        [
          "Run on a network",
          "docker run --network app-net --name db postgres"
        ],
        [
          "Clean up everything unused",
          "docker system prune"
        ]
      ]
    },
    {
      "title": "Compose",
      "description": "Multi-container apps.",
      "rows": [
        [
          "Start in the background",
          "docker compose up -d"
        ],
        [
          "Rebuild and start",
          "docker compose up -d --build"
        ],
        [
          "Stop and remove",
          [
            "docker compose down",
            "docker compose down -v  # and volumes"
          ]
        ],
        [
          "Logs",
          "docker compose logs -f api"
        ],
        [
          "Run a command in a service",
          "docker compose exec api sh"
        ],
        [
          "compose.yaml example",
          "services:\n  api:\n    build: .\n    ports:\n      - \"3000:3000\"\n    environment:\n      DATABASE_URL: postgres://db/app\n    depends_on:\n      - db\n  db:\n    image: postgres:17\n    volumes:\n      - db-data:/var/lib/postgresql/data\nvolumes:\n  db-data:"
        ]
      ]
    },
    {
      "title": "Dockerfile",
      "description": "Describe how to build an image.",
      "rows": [
        [
          "Node.js app",
          "FROM node:22-alpine\nWORKDIR /app\nCOPY package*.json ./\nRUN npm ci --omit=dev\nCOPY . .\nEXPOSE 3000\nCMD [\"node\", \"server.js\"]"
        ],
        [
          "Multi-stage build",
          "FROM node:22 AS build\nWORKDIR /app\nCOPY . .\nRUN npm ci && npm run build\n\nFROM nginx:alpine\nCOPY --from=build /app/dist /usr/share/nginx/html"
        ],
        [
          "Ignore files",
          "# .dockerignore\nnode_modules\n.git\n.env"
        ]
      ]
    }
  ]
}
