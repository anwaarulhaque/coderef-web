            "color: oklch(60% 0.2 260);"
          ]
        ],
        [
          "Gradient",
          "background: linear-gradient(135deg, #2563eb, #9333ea);"
        ],
        [
          "Load a web font",
          "@import url(\"https://fonts.googleapis.com/css2?family=Inter&display=swap\");"
        ]
      ]
    },
    {
      "title": "Responsive",
      "description": "Adapting to screen size.",
      "rows": [
        [
          "Media query",
          "@media (min-width: 768px) {\n  .sidebar { display: block; }\n}"
        ],
        [
          "Dark mode",
          "@media (prefers-color-scheme: dark) {\n  body { background: #111; color: #eee; }\n}"
        ],
        [
          "Reduced motion",
          "@media (prefers-reduced-motion: reduce) {\n  * { animation: none; transition: none; }\n}"
        ],
        [
          "Fluid size",
          "font-size: clamp(1rem, 2.5vw, 2rem);"
        ],
        [
          "Container query",
          ".cards { container-type: inline-size; }\n@container (min-width: 500px) {\n  .card { display: flex; }\n}"
        ],
        [
          "Responsive image",
          "img { max-width: 100%; height: auto; }"
        ]
      ]
    },
    {
      "title": "Variables & effects",
      "description": "Custom properties, transitions and animation.",
      "rows": [
        [
          "Define and use a variable",
          ":root { --brand: #2563eb; }\n.button { background: var(--brand); }"
        ],
        [
          "Variable with fallback",
          "color: var(--text, #111);"
        ],
        [
          "Transition",
          "transition: transform 200ms ease, opacity 200ms ease;"
        ],
        [
          "Transform",
          [
            "transform: translateY(-4px);",
            "transform: rotate(45deg) scale(1.1);"
          ]
        ],
        [
          "Keyframe animation",
          "@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n.loader { animation: spin 1s linear infinite; }"
        ],
        [
          "Visually hidden (screen-reader only)",
          ".sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}"
        ],
        [
          "Nesting",
          ".card {\n  padding: 1rem;\n  & h2 { margin: 0; }\n  &:hover { box-shadow: 0 2px 8px #0002; }\n}"
        ]
      ]
    }
