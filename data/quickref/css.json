    {
      "title": "Box model & spacing",
      "description": "Size, padding, borders and margins.",
      "rows": [
        [
          "Include padding in width",
          "*, *::before, *::after { box-sizing: border-box; }"
        ],
        [
          "Padding / margin",
          [
            "padding: 16px;",
            "padding: 8px 16px;",
            "margin: 0 auto;  /* center a block */"
          ]
        ],
        [
          "Width limits",
          [
            "max-width: 60rem;",
            "min-height: 100vh;"
          ]
        ],
        [
          "Border",
          [
            "border: 1px solid #ddd;",
            "border-radius: 8px;"
          ]
        ],
        [
          "Shadow",
          "box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);"
        ],
        [
          "Hide overflow / scroll",
          [
            "overflow: hidden;",
            "overflow-y: auto;"
          ]
        ],
        [
          "Aspect ratio",
          "aspect-ratio: 16 / 9;"
        ]
      ]
    },
    {
      "title": "Layout",
      "description": "Flexbox, grid and positioning.",
      "rows": [
        [
          "Row with space between",
          ".row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 1rem;\n}"
        ],
        [
          "Center anything",
          ".center {\n  display: grid;\n  place-items: center;\n}"
        ],
        [
          "Wrap items",
          "flex-wrap: wrap;"
        ],
        [
          "Item fills remaining space",
          "flex: 1;"
        ],
        [
          "Responsive card grid",
          ".grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n  gap: 1rem;\n}"
        ],
        [
          "Span grid columns",
          "grid-column: span 2;"
        ],
        [
          "Position over a parent",
          [
            ".parent { position: relative; }",
            ".badge { position: absolute; top: 0; right: 0; }"
          ]
        ],
        [
          "Sticky header",
          "position: sticky;\ntop: 0;"
        ],
        [
          "Stack order",
          "z-index: 10;"
        ]
      ]
    },
    {
      "title": "Typography & color",
