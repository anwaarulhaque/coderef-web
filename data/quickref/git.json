{
  "slug": "git",
  "updated": "2026-10-14",
  "title": "Git",
  "category": "Tools",
  "color": "#f05032",
  "language": "bash",
  "description": "Git commands for setup, saving changes, branching, merging, remotes, undoing mistakes and inspecting history.",
  "docs": "https://git-scm.com/docs",
  "try": {
    "label": "Practise in Git Branching",
    "href": "/git-branching/"
  },
  "sections": [
    {
      "title": "Setup",
      "description": "Configure Git and start a repository.",
      "rows": [
        [
          "Set your name and email",
          "git config --global user.name \"Ada Lovelace\"\ngit config --global user.email ada@example.com"
        ],
        [
          "Default branch name",
          "git config --global init.defaultBranch main"
        ],
        [
          "Start a repo",
          "git init"
        ],
        [
          "Clone a repo",
          [
            "git clone https://github.com/user/repo.git",
            "git clone <url> my-folder"
          ]
        ],
        [
          "Ignore files",
          "echo \"node_modules/\" >> .gitignore"
        ]
      ]
    },
    {
      "title": "Saving changes",
      "description": "Stage and commit.",
      "rows": [
        [
          "See what changed",
          [
            "git status",
            "git status -s"
          ]
        ],
        [
          "Stage files",
          [
            "git add file.txt",
            "git add .",
            "git add -p   # pick hunks"
          ]
        ],
        [
          "Unstage a file",
          "git restore --staged file.txt"
        ],
        [
          "Commit",
          [
            "git commit -m \"Add login form\"",
            "git commit -am \"Fix typo\"  # tracked files"
          ]
        ],
        [
          "Fix the last commit",
          [
            "git commit --amend",
            "git commit --amend --no-edit"
          ]
        ],
        [
          "See differences",
          [
            "git diff",
            "git diff --staged",
            "git diff main..feature"
          ]
        ]
      ]
    },
    {
      "title": "Branches",
      "description": "Create, switch and clean up branches.",
      "rows": [
        [
          "List branches",
          [
            "git branch",
            "git branch -a"
          ]
        ],
        [
          "Create and switch",
          [
            "git switch -c feature",
            "git checkout -b feature"
          ]
        ],
        [
          "Switch branch",
          [
            "git switch main",
            "git switch -   # previous"
          ]
        ],
        [
          "Rename current branch",
          "git branch -m new-name"
        ],
        [
          "Delete a branch",
          [
            "git branch -d feature",
            "git branch -D feature  # force"
          ]
        ],
        [
          "Delete a remote branch",
          "git push origin --delete feature"
        ]
      ]
    },
    {
      "title": "Merging & rebasing",
      "description": "Bring work together.",
      "rows": [
        [
          "Merge a branch into the current one",
          "git merge feature"
        ],
        [
          "Merge with a merge commit",
          "git merge --no-ff feature"
        ],
        [
          "Rebase onto main",
          "git rebase main"
        ],
        [
          "Interactive rebase (squash, reorder)",
          "git rebase -i HEAD~3"
        ],
        [
          "Copy a commit",
          "git cherry-pick a1b2c3d"
        ],
        [
          "Resolve a conflict",
          "# edit the files, then:\ngit add .\ngit merge --continue   # or git rebase --continue"
        ],
        [
          "Abort",
          [
            "git merge --abort",
            "git rebase --abort"
          ]
        ]
      ]
    },
    {
      "title": "Remotes",
      "description": "Share work with others.",
      "rows": [
        [
          "List remotes",
          "git remote -v"
        ],
        [
          "Add a remote",
          "git remote add origin https://github.com/user/repo.git"
        ],
        [
          "Download changes",
          [
            "git fetch",
            "git fetch --prune"
          ]
        ],
        [
          "Download and merge",
          [
            "git pull",
            "git pull --rebase"
          ]
        ],
        [
          "Upload",
          [
            "git push",
            "git push -u origin feature  # first push"
          ]
        ],
        [
          "Force push safely",
          "git push --force-with-lease"
        ]
      ]
    },
    {
      "title": "Undoing things",
      "description": "Fix mistakes.",
      "rows": [
        [
          "Discard changes to a file",
          "git restore file.txt"
        ],
        [
          "Undo last commit, keep changes",
          "git reset --soft HEAD~1"
        ],
        [
          "Undo last commit, discard changes",
          "git reset --hard HEAD~1"
        ],
        [
          "Undo a pushed commit safely",
          "git revert a1b2c3d"
        ],
        [
          "Stash work in progress",
          [
            "git stash",
            "git stash pop",
            "git stash list"
          ]
        ],
        [
          "Remove untracked files",
          [
            "git clean -n  # preview",
            "git clean -fd"
          ]
        ],
        [
          "Find a lost commit",
          "git reflog"
        ]
      ]
    },
    {
      "title": "History & tags",
      "description": "Inspect and label.",
      "rows": [
        [
          "Log",
          [
            "git log --oneline",
            "git log --oneline --graph --all"
          ]
        ],
        [
          "Show a commit",
          "git show a1b2c3d"
        ],
        [
          "Who changed a line",
          "git blame file.txt"
        ],
        [
          "Search history for text",
          "git log -S \"functionName\""
        ],
        [
          "Tag a release",
          [
            "git tag v1.0.0",
            "git tag -a v1.0.0 -m \"Release 1.0\""
          ]
        ],
        [
          "Push tags",
          "git push --tags"
        ]
      ]
    }
  ]
}
