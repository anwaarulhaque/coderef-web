{
  "slug": "css-grid",
  "title": "CSS Grid",
  "category": "Web",
  "color": "#a855f7",
  "kind": "visual",
  "description": "Visual cheat sheet for CSS Grid Layout — every property with live previews you can copy.",
  "reference": "https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_grid_layout",
  "sections": [
    {
      "title": "Grid container",
      "groups": [
        {
          "title": "display",
          "description": "Makes the element a grid container; its direct children become grid items.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/display",
          "demo": {
            "base": "gap: 3px; grid-template-columns: repeat(3, 14px);",
            "items": 6
          },
          "items": [
            {
              "name": "display: grid;"
            },
            {
              "name": "display: inline-grid;"
            }
          ]
        },
        {
          "title": "grid-template-columns",
          "description": "Defines the number and size of the columns.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/grid-template-columns",
          "demo": {
            "base": "display: grid; gap: 3px; height: 100%;",
            "items": 6
          },
          "items": [
            {
              "name": "grid-template-columns: repeat(3, 1fr);"
            },
            {
              "name": "grid-template-columns: 1fr 2fr 1fr;"
            },
            {
              "name": "grid-template-columns: 12px auto 12px;"
            },
            {
              "name": "grid-template-columns: repeat(auto-fill, minmax(18px, 1fr));"
            }
          ]
        },
        {
          "title": "grid-template-rows",
          "description": "Defines the number and size of the rows.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/grid-template-rows",
          "demo": {
            "base": "display: grid; gap: 3px; height: 100%; grid-template-columns: repeat(3, 1fr);",
            "items": 6
          },
          "items": [
            {
              "name": "grid-template-rows: 1fr 1fr;"
            },
            {
              "name": "grid-template-rows: 1fr 3fr;"
            },
            {
              "name": "grid-template-rows: 12px auto;"
            },
            {
              "name": "grid-template-rows: 30% 70%;"
            }
          ]
        },
        {
          "title": "grid-template-areas",
          "description": "Names regions of the grid; items are placed with grid-area.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/grid-template-areas",
          "demo": {
            "base": "display: grid; gap: 3px; height: 100%; grid-template-columns: 1fr 3fr; grid-template-rows: auto 1fr auto;",
            "items": 4,
            "itemStyles": [
              "grid-area: head",
              "grid-area: side",
              "grid-area: main",
              "grid-area: foot"
            ]
          },
          "items": [
            {
              "name": "grid-template-areas:\n  \"head head\"\n  \"side main\"\n  \"foot foot\";"
            },
            {
              "name": "grid-template-areas:\n  \"head head\"\n  \"main side\"\n  \"foot side\";"
            },
            {
              "name": "grid-template-areas:\n  \"side head\"\n  \"side main\"\n  \"side foot\";"
            },
            {
              "name": "grid-template-areas:\n  \"head head\"\n  \"main main\"\n  \"side foot\";"
            }
          ]
        },
        {
          "title": "gap",
          "description": "Sets the gutters between rows and columns.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/gap",
          "demo": {
            "base": "display: grid; height: 100%; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr);",
            "items": 9
          },
          "items": [
            {
              "name": "gap: 1px;"
            },
            {
              "name": "gap: 8px;"
            },
            {
              "name": "row-gap: 8px;\ncolumn-gap: 1px;"
            },
            {
              "name": "row-gap: 1px;\ncolumn-gap: 10px;"
            }
          ]
        },
        {
          "title": "justify-items",
          "description": "Aligns every item inside its cell along the row (inline) axis.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/justify-items",
          "demo": {
            "base": "display: grid; gap: 3px; height: 100%; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 1fr);",
            "items": 6
          },
          "items": [
            {
              "name": "justify-items: start;"
