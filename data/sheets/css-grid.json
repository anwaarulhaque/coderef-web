              "name": "align-content: space-around;"
            },
            {
              "name": "align-content: space-evenly;"
            }
          ]
        },
        {
          "title": "grid-auto-flow",
          "description": "Controls how items without an explicit position are placed.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/grid-auto-flow",
          "demo": {
            "base": "display: grid; gap: 3px; height: 100%; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr;",
            "items": 5,
            "itemStyles": [
              "grid-column: span 2",
              "grid-column: span 2"
            ]
          },
          "items": [
            {
              "name": "grid-auto-flow: row;"
            },
            {
              "name": "grid-auto-flow: row dense;"
