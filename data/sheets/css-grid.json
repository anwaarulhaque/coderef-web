        },
        {
          "title": "justify-content",
          "description": "Positions the whole grid along the row axis when it is smaller than its container.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/justify-content",
          "demo": {
            "base": "display: grid; gap: 3px; height: 100%; grid-template-columns: repeat(3, 14px); grid-template-rows: repeat(2, 1fr);",
            "items": 6
          },
          "items": [
            {
              "name": "justify-content: start;"
