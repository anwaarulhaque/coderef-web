          "demo": {
            "base": "display: grid; gap: 3px; height: 100%; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(2, 1fr);",
            "items": 6
          },
          "items": [
            {
              "name": "place-items: center;"
