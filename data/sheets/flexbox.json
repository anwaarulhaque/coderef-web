            {
              "name": "justify-content: flex-end;"
            },
            {
              "name": "justify-content: space-between;"
            },
            {
              "name": "justify-content: space-around;"
            },
            {
              "name": "justify-content: space-evenly;"
            }
          ]
        },
        {
          "title": "align-items",
          "description": "Aligns items on the cross axis. Items here have different heights so you can see the difference.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/align-items",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 3,
            "itemBase": "width: 26px;",
            "itemStyles": [
              "min-height: 26px; font-size: 16px",
              "min-height: 50px",
              "min-height: 18px; font-size: 9px"
