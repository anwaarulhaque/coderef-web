          },
          "items": [
            {
              "name": "align-items: flex-start;"
            },
            {
              "name": "align-items: center;"
            },
            {
              "name": "align-items: flex-end;"
            },
            {
              "name": "align-items: stretch;"
            },
            {
              "name": "align-items: baseline;"
            }
          ]
        },
        {
          "title": "align-content",
          "description": "Distributes wrapped lines on the cross axis (only matters when items wrap).",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/align-content",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box; flex-wrap: wrap;",
            "items": 6,
            "itemBase": "width: 28%; min-height: 18px;"
          },
          "items": [
            {
              "name": "align-content: flex-start;"
            },
            {
              "name": "align-content: center;"
            },
            {
              "name": "align-content: flex-end;"
            },
            {
              "name": "align-content: space-between;"
            },
            {
              "name": "align-content: space-around;"
            },
            {
              "name": "align-content: stretch;"
            }
          ]
        },
        {
          "title": "gap",
          "description": "Space between items and between wrapped lines — never at the edges.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/gap",
          "demo": {
            "base": "display: flex; flex-wrap: wrap; align-content: flex-start; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 6,
            "itemBase": "width: 24%; height: 22px;"
          },
          "items": [
            {
              "name": "gap: 0;"
            },
            {
              "name": "gap: 8px;"
            },
            {
              "name": "row-gap: 16px;\ncolumn-gap: 2px;"
            },
            {
              "name": "row-gap: 2px;\ncolumn-gap: 16px;"
            }
          ]
        }
      ]
    },
    {
      "title": "Flex items",
      "groups": [
        {
          "title": "order",
          "description": "Moves an item earlier or later than its position in the HTML. Default is 0.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/order",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 4,
            "itemBase": "width: 26px; height: 26px;",
            "target": 1
          },
          "items": [
            {
              "name": "order: 0;"
            },
            {
              "name": "order: -1;"
            },
            {
              "name": "order: 1;"
            }
          ]
        },
        {
          "title": "flex-grow",
          "description": "How much of the free space an item takes. Here the other items have flex-grow: 1.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/flex-grow",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 3,
            "itemBase": "width: 26px; height: 26px;",
            "itemStyles": [
              "flex-grow: 1",
              "",
              "flex-grow: 1"
            ],
            "target": 1
          },
          "items": [
            {
              "name": "flex-grow: 0;"
            },
            {
              "name": "flex-grow: 1;"
            },
            {
              "name": "flex-grow: 2;"
            },
            {
              "name": "flex-grow: 4;"
            }
          ]
        },
        {
          "title": "flex-shrink",
          "description": "How much an item gives up when there isn't enough room. Each item here wants 50% of the width.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/flex-shrink",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 3,
            "itemBase": "width: 50%; height: 26px;",
            "target": 1
          },
          "items": [
            {
              "name": "flex-shrink: 1;"
            },
            {
              "name": "flex-shrink: 0;"
            },
            {
              "name": "flex-shrink: 4;"
            }
          ]
        },
        {
          "title": "flex-basis",
          "description": "The item's starting size on the main axis, before free space is shared out.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/flex-basis",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 3,
            "itemBase": "height: 26px;",
            "itemStyles": [
              "width: 26px",
              "",
              "width: 26px"
            ],
            "target": 1
          },
          "items": [
            {
              "name": "flex-basis: auto;"
            },
            {
              "name": "flex-basis: 48px;"
            },
            {
              "name": "flex-basis: 50%;"
            },
            {
              "name": "flex-basis: 0;\nflex-grow: 1;"
            }
          ]
        },
        {
          "title": "flex",
          "description": "Shorthand for flex-grow, flex-shrink and flex-basis. The other items here have flex: 1.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/flex",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 3,
            "itemBase": "height: 26px;",
            "itemStyles": [
              "flex: 1",
              "",
              "flex: 1"
            ],
            "target": 1
          },
          "items": [
            {
              "name": "flex: 1;"
            },
            {
              "name": "flex: 2;"
