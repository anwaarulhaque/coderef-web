            {
              "name": "flex-flow: row-reverse wrap;"
            },
            {
              "name": "flex-flow: column wrap;"
            },
            {
              "name": "flex-flow: column-reverse wrap;"
            }
          ]
        },
        {
          "title": "justify-content",
          "description": "Distributes items and free space along the main axis.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/justify-content",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 3,
            "itemBase": "width: 26px; height: 26px;"
          },
          "items": [
            {
              "name": "justify-content: flex-start;"
            },
            {
              "name": "justify-content: center;"
