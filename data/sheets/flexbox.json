{
  "slug": "flexbox",
  "title": "Flexbox",
  "category": "Web",
  "color": "#14b8a6",
  "kind": "visual",
  "description": "Visual cheat sheet for CSS Flexible Box Layout — every property with live previews you can copy. The dashed box is the flex container.",
  "reference": "https://developer.mozilla.org/en-US/docs/Web/CSS/CSS_flexible_box_layout",
  "sections": [
    {
      "title": "Flex container",
      "groups": [
        {
          "title": "display",
          "description": "flex lays children out in a row. inline-flex does the same, but the container only takes the width it needs.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/display",
          "demo": {
            "base": "gap: 4px; padding: 4px; box-sizing: border-box;",
            "items": 3,
            "itemBase": "width: 26px; height: 26px;"
          },
          "items": [
            {
              "name": "display: block;"
            },
            {
              "name": "display: flex;"
            },
            {
              "name": "display: inline-flex;"
            }
          ]
        },
        {
          "title": "flex-direction",
          "description": "Sets the main axis — the direction items flow in.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/flex-direction",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 3,
            "itemBase": "width: 26px; height: 26px;"
          },
          "items": [
            {
              "name": "flex-direction: row;"
            },
            {
              "name": "flex-direction: row-reverse;"
            },
            {
              "name": "flex-direction: column;"
            },
            {
              "name": "flex-direction: column-reverse;"
            }
          ]
        },
        {
          "title": "flex-wrap",
          "description": "nowrap squeezes every item onto one line; wrap moves items that don't fit onto new lines.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/flex-wrap",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 7,
            "itemBase": "width: 28%; height: 22px;"
          },
          "items": [
            {
              "name": "flex-wrap: nowrap;"
            },
            {
              "name": "flex-wrap: wrap;"
            },
            {
              "name": "flex-wrap: wrap-reverse;"
            }
          ]
        },
        {
          "title": "flex-flow",
          "description": "Shorthand for flex-direction and flex-wrap.",
          "url": "https://developer.mozilla.org/en-US/docs/Web/CSS/flex-flow",
          "demo": {
            "base": "display: flex; gap: 4px; height: 100%; padding: 4px; box-sizing: border-box;",
            "items": 7,
            "itemBase": "width: 28%; height: 22px;"
          },
          "items": [
            {
              "name": "flex-flow: row wrap;"
