# Cloudflare static-asset headers (copied to out/_headers by the build).

# Fingerprinted build assets never change — cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Logo, icons and fonts: cache for a week.
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800

# Search index: refreshed on every deploy.
/search-index.json
  Cache-Control: public, max-age=3600

# Security headers for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
